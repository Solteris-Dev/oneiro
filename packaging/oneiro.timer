[Unit]
Description=Run oneiro nightly

[Timer]
# The dream. Late enough to catch the whole day, with a spread so it never
# lands at the same instant as everything else on the machine.
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=30m
# If the machine was asleep at 04:30, run at next boot rather than skipping.
Persistent=true

[Install]
WantedBy=timers.target
