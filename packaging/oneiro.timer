[Unit]
Description=Run oneiro nightly

[Timer]
# The dream. Late enough to catch the whole day, early enough that the user is
# plausibly asleep — 04:30 was not, on the evidence. The spread keeps it off the
# same instant as everything else on the machine.
OnCalendar=*-*-* 06:00:00
RandomizedDelaySec=30m
# If the machine was off at that hour, run at next boot rather than skipping.
Persistent=true

[Install]
WantedBy=timers.target
